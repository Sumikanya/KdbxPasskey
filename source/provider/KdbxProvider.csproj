<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
  <AssemblyName>KeePassPasskeyProvider</AssemblyName><RootNamespace>KeePassPasskeyProvider</RootNamespace>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <ApplicationManifest>../upstream/src/KeePassPasskeyProvider/app.manifest</ApplicationManifest>
  <ApplicationIcon>../upstream/src/KeePassPasskeyProvider/Resources/app-icon.ico</ApplicationIcon>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../upstream/src/KeePassPasskeyShared/KeePassPasskeyShared.csproj" />
  <Compile Include="../upstream/src/KeePassPasskeyProvider/Authenticator/**/*.cs" Exclude="../upstream/src/KeePassPasskeyProvider/Authenticator/UserVerification/DialogUserVerifier.cs;../upstream/src/KeePassPasskeyProvider/Authenticator/UserVerification/NotificationUserVerifier.cs;../upstream/src/KeePassPasskeyProvider/Authenticator/UserVerification/UserVerifierDispatcher.cs" />
  <Compile Include="../upstream/src/KeePassPasskeyProvider/Util/Win32Native.cs;../upstream/src/KeePassPasskeyProvider/Util/SettingsCache.cs;../upstream/src/KeePassPasskeyProvider/Util/Notifier.cs;../upstream/src/KeePassPasskeyProvider/Util/AuthenticatorSettingsStore.cs;../upstream/src/KeePassPasskeyProvider/Util/AppPaths.cs" />
  <EmbeddedResource Include="../upstream/src/KeePassPasskeyProvider/Resources/logo-*.svg" Link="Resources/%(Filename)%(Extension)" />
  <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
 </ItemGroup>
</Project>
